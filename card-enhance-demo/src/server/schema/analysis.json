{
  "type": "object",
  "additionalProperties": false,
  "required": ["summary", "cardType", "subjects", "problems", "fixes", "corners", "cardTopFacing", "orientationReason", "cardAspectRatio", "cornerRadiusRatio", "adjustments"],
  "properties": {
    "summary": { "type": "string", "description": "사진 속 카드와 촬영 상황 한 줄 요약" },
    "cardType": { "type": "string", "description": "카드 종류 (포토카드, 스티커 카드 등)" },
    "subjects": { "type": "array", "items": { "type": "string" }, "description": "카드 속 인물/캐릭터 각각의 위치, 포즈, 표정" },
    "problems": { "type": "array", "items": { "type": "string" }, "description": "밝기/색/대비 측면의 문제 (어두움, 색 캐스트, 뿌옇게 뜸 등)" },
    "fixes": { "type": "array", "items": { "type": "string" }, "description": "problems 각각에 대한 개선안. adjustments 값과 일치해야 함" },
    "corners": {
      "type": "array", "minItems": 4, "maxItems": 4,
      "description": "카드 네 꼭짓점의 정규화 좌표 (x: 왼쪽 0 ~ 오른쪽 1, y: 위 0 ~ 아래 1). 둥근 모서리면 두 변을 연장한 가상의 꼭짓점",
      "items": { "type": "object", "additionalProperties": false, "required": ["x", "y"], "properties": { "x": { "type": "number" }, "y": { "type": "number" } } }
    },
    "cardTopFacing": { "type": "string", "enum": ["up", "down", "left", "right"], "description": "카드의 위쪽 가장자리(인물 머리 방향, 글자 윗부분)가 지금 사진에서 향하는 방향" },
    "orientationReason": { "type": "string", "description": "cardTopFacing 판단 근거" },
    "cardAspectRatio": { "type": "number", "description": "카드를 정방향으로 세웠을 때 가로/세로 비율" },
    "cornerRadiusRatio": { "type": "number", "description": "모서리 반지름 / 카드 가로 길이. 각진 카드는 0, 일반 포토카드는 0.04~0.07" },
    "adjustments": {
      "type": "object", "additionalProperties": false,
      "required": ["brightness", "contrast", "saturation", "redGain", "greenGain", "blueGain"],
      "description": "원본 느낌을 유지하는 가벼운 보정. 1.0 이 변화 없음",
      "properties": {
        "brightness": { "type": "number", "description": "0.85 ~ 1.4" },
        "contrast": { "type": "number", "description": "0.85 ~ 1.25" },
        "saturation": { "type": "number", "description": "0.85 ~ 1.25" },
        "redGain": { "type": "number", "description": "화이트 밸런스용 채널 배율, 0.88 ~ 1.12" },
        "greenGain": { "type": "number", "description": "0.88 ~ 1.12" },
        "blueGain": { "type": "number", "description": "0.88 ~ 1.12" }
      }
    }
  }
}
